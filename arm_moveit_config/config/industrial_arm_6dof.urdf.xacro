<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="industrial_arm_6dof">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import industrial_arm_6dof urdf file -->
    <xacro:include filename="$(find arm_6dof_description)/urdf/robot.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="industrial_arm_6dof.ros2_control.xacro" />


    <xacro:industrial_arm_6dof_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
