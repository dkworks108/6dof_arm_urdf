<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="industrial_arm_6dof">

  <xacro:arg name="gazebo_system" default="ignition"/>
  <xacro:arg name="controllers_yaml" default="config/controllers.yaml"/>

  <!-- ==================== Materials ==================== -->
  <material name="industrial_orange">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>

  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <material name="silver">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>

  <material name="gripper_body">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="finger_pad">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="accent_blue">
    <color rgba="0.1 0.45 0.85 1.0"/>
  </material>

  <!-- ==================== World Anchor Link ==================== -->
  <!-- Anchoring base_link to world prevents the arm from tipping over under gravity in simulation -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Base Link ==================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.025" ixy="0.0" ixz="0.0" iyy="0.025" iyz="0.0" izz="0.045"/>
    </inertial>
  </link>

  <!-- ==================== Joint 1: Shoulder Pan (Yaw) ==================== -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="100.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Link 1 -->
  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.2"/>
      </geometry>
      <material name="industrial_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.016" ixy="0.0" ixz="0.0" iyy="0.016" iyz="0.0" izz="0.012"/>
    </inertial>
  </link>

  <!-- ==================== Joint 2: Shoulder Lift (Pitch) ==================== -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094" upper="2.094" effort="100.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Link 2: Upper Arm -->
  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.1 0.4"/>
      </geometry>
      <material name="industrial_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.1 0.4"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.035" ixy="0.0" ixz="0.0" iyy="0.035" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>

  <!-- ==================== Joint 3: Elbow Flex (Pitch) ==================== -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.618" upper="2.618" effort="60.0" velocity="2.0"/>
    <dynamics damping="0.4" friction="0.08"/>
  </joint>

  <!-- Link 3: Forearm -->
  <link name="link_3">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.25"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.25"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <mass value="1.8"/>
      <inertia ixx="0.011" ixy="0.0" ixz="0.0" iyy="0.011" iyz="0.0" izz="0.003"/>
    </inertial>
  </link>

  <!-- ==================== Joint 4: Wrist Roll ==================== -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="30.0" velocity="3.0"/>
    <dynamics damping="0.3" friction="0.05"/>
  </joint>

  <!-- Link 4 -->
  <link name="link_4">
    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.15"/>
      </geometry>
      <material name="industrial_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.0015"/>
    </inertial>
  </link>

  <!-- ==================== Joint 5: Wrist Pitch ==================== -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094" upper="2.094" effort="30.0" velocity="3.0"/>
    <dynamics damping="0.2" friction="0.04"/>
  </joint>

  <!-- Link 5 -->
  <link name="link_5">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.08 0.1"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.08 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0007"/>
    </inertial>
  </link>

  <!-- ==================== Joint 6: Wrist Roll / Flange Rotation ==================== -->
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="20.0" velocity="4.0"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>

  <!-- Link 6: Mounting Flange -->
  <link name="link_6">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00016" ixy="0.0" ixz="0.0" iyy="0.00016" iyz="0.0" izz="0.00024"/>
    </inertial>
  </link>

  <!-- ==================== Tool0 Joint: Standard Flange Interface ==================== -->
  <joint name="joint_tool0" type="fixed">
    <parent link="link_6"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- Link: tool0 -->
  <link name="tool0">
    <visual>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.004"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.004"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000018" ixy="0.0" ixz="0.0" iyy="0.000018" iyz="0.0" izz="0.000036"/>
    </inertial>
  </link>

  <!-- ==================== Parallel Gripper Assembly ==================== -->
  <!-- Gripper Mounting Joint -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0.004" rpy="0 0 0"/>
  </joint>

  <!-- Gripper Base Chassis -->
  <link name="gripper_base_link">
    <!-- Main Chassis Housing -->
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.10 0.05"/>
      </geometry>
      <material name="gripper_body"/>
    </visual>
    <!-- Cylindrical Actuator Hub -->
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.032" length="0.03"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <!-- Dual Linear Slide Rails -->
    <visual>
      <origin xyz="0 0 0.045" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.075"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.10 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00052" ixy="0.0" ixz="0.0" iyy="0.00031" iyz="0.0" izz="0.00062"/>
    </inertial>
  </link>

  <!-- Left Finger Joint (Prismatic: sliding in +Y direction) -->
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0 0.015 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.035" effort="30.0" velocity="0.15"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- Left Finger Link -->
  <link name="left_finger_link">
    <!-- Rigid Finger Body -->
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.012 0.06"/>
      </geometry>
      <material name="accent_blue"/>
    </visual>
    <!-- High-Friction Grip Pad -->
    <visual>
      <origin xyz="0 -0.0055 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.003 0.035"/>
      </geometry>
      <material name="finger_pad"/>
    </visual>
    <collision>
      <origin xyz="0 -0.001 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.014 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="0.000019" ixy="0.0" ixz="0.0" iyy="0.000021" iyz="0.0" izz="0.000004"/>
    </inertial>
  </link>

  <!-- Right Finger Joint (Prismatic: sliding in -Y direction, symmetric mimic) -->
  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0 -0.015 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.035" upper="0.0" effort="30.0" velocity="0.15"/>
    <mimic joint="left_finger_joint" multiplier="-1.0" offset="0.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- Right Finger Link -->
  <link name="right_finger_link">
    <!-- Rigid Finger Body -->
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.012 0.06"/>
      </geometry>
      <material name="accent_blue"/>
    </visual>
    <!-- High-Friction Grip Pad -->
    <visual>
      <origin xyz="0 0.0055 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.003 0.035"/>
      </geometry>
      <material name="finger_pad"/>
    </visual>
    <collision>
      <origin xyz="0 0.001 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.014 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="0.000019" ixy="0.0" ixz="0.0" iyy="0.000021" iyz="0.0" izz="0.000004"/>
    </inertial>
  </link>

  <!-- ==================== Tool Center Point (TCP) Frame ==================== -->
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>

  <link name="tool_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.0000001" ixy="0.0" ixz="0.0" iyy="0.0000001" iyz="0.0" izz="0.0000001"/>
    </inertial>
  </link>

  <!-- ==================== Gazebo Physics & Friction Properties ==================== -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
  </gazebo>

  <gazebo reference="link_1">
    <material>Gazebo/Orange</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="link_2">
    <material>Gazebo/Orange</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="link_3">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="link_4">
    <material>Gazebo/Orange</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="link_5">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="link_6">
    <material>Gazebo/Grey</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="tool0">
    <material>Gazebo/Grey</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <gazebo reference="gripper_base_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <!-- High-friction contact surfaces for realistic physics grasping -->
  <gazebo reference="left_finger_link">
    <material>Gazebo/Blue</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo reference="right_finger_link">
    <material>Gazebo/Blue</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <!-- ==================== ros2_control Hardware Interface ==================== -->
  <ros2_control name="IndustrialArm6dofHardware" type="system">
    <hardware>
      <xacro:if value="${'$(arg gazebo_system)' == 'ignition'}">
        <plugin>ign_ros2_control/IgnitionSystem</plugin>
      </xacro:if>
      <xacro:unless value="${'$(arg gazebo_system)' == 'ignition'}">
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </xacro:unless>
    </hardware>

    <!-- 6 Arm Revolute Joints -->
    <joint name="joint_1">
      <command_interface name="position">
        <param name="min">-3.1416</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_2">
      <command_interface name="position">
        <param name="min">-2.094</param>
        <param name="max">2.094</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_3">
      <command_interface name="position">
        <param name="min">-2.618</param>
        <param name="max">2.618</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_4">
      <command_interface name="position">
        <param name="min">-3.1416</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_5">
      <command_interface name="position">
        <param name="min">-2.094</param>
        <param name="max">2.094</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_6">
      <command_interface name="position">
        <param name="min">-6.2832</param>
        <param name="max">6.2832</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Gripper Prismatic Joints -->
    <joint name="left_finger_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.035</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_finger_joint">
      <command_interface name="position">
        <param name="min">-0.035</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ==================== Gazebo ros2_control Plugin ==================== -->
  <xacro:if value="${'$(arg gazebo_system)' == 'ignition'}">
    <gazebo>
      <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>$(arg controllers_yaml)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
  <xacro:unless value="${'$(arg gazebo_system)' == 'ignition'}">
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(arg controllers_yaml)</parameters>
      </plugin>
    </gazebo>
  </xacro:unless>

</robot>
